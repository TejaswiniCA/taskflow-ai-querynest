# Google Gemini API Key (used for chat generation & embeddings)
GOOGLE_GENERATIVE_AI_API_KEY=

# Local PostgreSQL example. For hosted PostgreSQL, verify the server certificate
# (sslmode=verify-full) and use a dedicated least-privilege database role.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/taskflow_ai

# Application settings
NEXT_PUBLIC_APP_NAME="TaskFlow AI"

# Local interview demo only. Ignored in production; do not deploy with this mode.
TASKFLOW_LOCAL_AUTH=false

# Better Auth server secret (generate locally with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Must match the local application URL and Google OAuth redirect URI
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth Web application credentials; keep actual values in .env.local only
TASKFLOW_GOOGLE_CLIENT_ID=your-google-oauth-client-id
TASKFLOW_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Only this verified Google account is allowed to register or sign in
TASKFLOW_ALLOWED_EMAIL=you@example.com
